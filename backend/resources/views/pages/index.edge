@slot('main')
<div class="min-h-screen bg-gray-100 p-6">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">Tableau de bord</h1>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-white shadow rounded-lg p-5">
      <div class="text-sm font-medium text-gray-500">Utilisateurs inscrits</div>
      <div class="mt-2 text-2xl font-semibold text-green-600">12 345</div>
    </div>
    <div class="bg-white shadow rounded-lg p-5">
      <div class="text-sm font-medium text-gray-500">Chasses actives</div>
      <div class="mt-2 text-2xl font-semibold text-green-600">128</div>
    </div>
    <div class="bg-white shadow rounded-lg p-5">
      <div class="text-sm font-medium text-gray-500">Revenus ce mois</div>
      <div class="mt-2 text-2xl font-semibold text-green-600">8 450 €</div>
    </div>
    <div class="bg-white shadow rounded-lg p-5">
      <div class="text-sm font-medium text-gray-500">Tickets support</div>
      <div class="mt-2 text-2xl font-semibold text-green-600">23</div>
    </div>
  </div>

  <div class="bg-white shadow rounded-lg p-6 mb-8">
    <h2 class="text-xl font-semibold text-gray-700 mb-4">Visites quotidiennes (dernier mois)</h2>
    <div class="w-full h-64 bg-gray-200 rounded flex items-center justify-center text-gray-500">
      Pas de données disponibles
    </div>
  </div>

  <div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full bg-white">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nouveaux utilisateurs</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Chasses créées</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Revenus (€)</th>
        </tr>
      </thead>
      <tbody>
        @each(day in [1,2,3,4,5,6,7])
        <tr class="border-b">
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">2025-05-0{{ day }}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{{ 5 * day }}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{{ 2 * day }}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{{ 100 * day }}</td>
        </tr>
        @endeach
      </tbody>
    </table>
